# Copy to .env.local and fill in real values. Never commit .env.local.

# Credentials for the single demo login gate. Choose your own values; do not
# reuse the ones from any shared documentation.
DEMO_LOGIN_EMAIL=demo@example.com
DEMO_LOGIN_PASSWORD=change-me

# Random secret used to sign the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
