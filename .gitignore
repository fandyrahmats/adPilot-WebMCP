# ---------------------------------------------------------------------------
# AdPilot — ignore rules
#
# Tracked on purpose: package-lock.json (Render runs `npm ci`), LICENSE,
# render.yaml, README.md, and everything under src/.
#
# Deliberately NOT tracked: internal planning material. The PRD, the rule
# snapshot, and the agent steering files are working notes, not part of the
# shipped product, and they are not required by the submission.
# ---------------------------------------------------------------------------

# Internal planning material and IDE agent configuration
/docs/
/.kiro/

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
!.yarn/sdks

# Next.js build output
/.next/
/out/
/build
/dist

# Generated by the Next.js toolchain, recreated on every build
next-env.d.ts
*.tsbuildinfo

# Caches
.eslintcache
.turbo
.swc/
.cache/

# Test output
/coverage
/.nyc_output
/playwright-report
/test-results

# Secrets and local environment. Never commit a real value; the workspace runs
# on the demo provider and needs no variables. Example files stay tracked.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Hosting providers
.vercel
.netlify

# Editors and IDEs
.idea/
*.iml
*.swp
*.swo
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json

# Operating system cruft
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
